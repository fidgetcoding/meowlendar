{
  "name": "meowlendar",
  "private": true,
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "verify:mcp-pack": "node scripts/verify-mcp-pack.mjs",
    "dev": "turbo dev --filter=@poolendar/web",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "turbo generate-types"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@supabase/supabase-js": "^2.49.4",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.32"
    }
  }
}
