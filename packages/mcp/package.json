{
  "name": "meowlendar-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for Meowlendar: calendar, tasks, routines, and booking tools for Claude Code and other MCP clients",
  "main": "./dist/index.js",
  "bin": {
    "meowlendar-mcp": "./dist/index.js",
    "meowlendar-vault": "./dist/vault-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@poolendar/api-client": "workspace:*",
    "@poolendar/types": "workspace:*",
    "@poolendar/validators": "workspace:*",
    "@types/node": "^22.15.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "license": "MIT",
  "author": "Nate Davidovich",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fidgetcoding/meowlendar.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/fidgetcoding/meowlendar/tree/main/packages/mcp",
  "bugs": {
    "url": "https://github.com/fidgetcoding/meowlendar/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "calendar",
    "tasks",
    "claude",
    "model-context-protocol"
  ]
}
